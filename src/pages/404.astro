---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";
---

<MainGridLayout title="页面不存在" description="404 —— 这个页面走丢了">
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative">
		<div class="card-base z-10 px-6 md:px-9 py-12 relative w-full flex flex-col items-center text-center">
			<div class="text-[5.5rem] md:text-[7rem] leading-none font-bold text-[var(--primary)] select-none">
				404
			</div>

			<h1 class="mt-6 text-xl md:text-2xl font-bold text-black/90 dark:text-white/90">
				这个页面走丢了
			</h1>
			<p class="mt-3 text-sm md:text-base text-black/60 dark:text-white/60 max-w-md">
				你要找的地址不存在，可能是链接拼错了，也可能是文章被移动或删除了。
			</p>

			<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
				<a href={url("/")} class="btn-card card-base rounded-xl px-5 py-2.5 font-bold text-sm md:text-base gap-2">
					<Icon name="material-symbols:home-outline-rounded" class="text-lg" />
					回到首页
				</a>
				<a href={url("/archive/")} class="btn-card card-base rounded-xl px-5 py-2.5 font-bold text-sm md:text-base gap-2">
					<Icon name="material-symbols:calendar-month-outline-rounded" class="text-lg" />
					浏览归档
				</a>
			</div>

			<p class="mt-8 text-xs text-black/40 dark:text-white/40">
				想找某篇文章？首页左上角可以搜索。
			</p>
		</div>
	</div>
</MainGridLayout>
